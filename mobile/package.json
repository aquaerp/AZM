{
  "name": "azm-mobile",
  "version": "1.2.1",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "build:android:apk": "npx eas-cli@latest build --platform android --profile preview",
    "build:ios:ipa": "npx eas-cli@latest build --platform ios --profile preview"
  },
  "dependencies": {
    "expo": "~57.0.14",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "^0.21.0"
  }
}
