# Copy to /opt/azm/deploy/hostinger/backup.env and protect it with chmod 600.
# The rclone remote must be limited to the dedicated backup bucket.
AZM_BACKUP_REMOTE=azm-backup:Azmcar
AZM_BACKUP_REQUIRE_REMOTE=true

# Optional heartbeat URL from healthchecks.io or an equivalent monitor.
AZM_BACKUP_HEALTHCHECK_URL=
