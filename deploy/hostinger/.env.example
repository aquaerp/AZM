# Public endpoint. The DNS A record for this name must point to the VPS IPv4.
AZM_DOMAIN=tidesight.cloud
ACME_EMAIL=admin@example.com
# Bind addresses can isolate a parallel staging stack from production.
AZM_HTTP_BIND=0.0.0.0:80
AZM_HTTPS_BIND=0.0.0.0:443

# Use unique, high-entropy values. Never commit the resulting .env file.
POSTGRES_DB=azm
POSTGRES_USER=azm_app
POSTGRES_PASSWORD=replace-with-a-long-unique-password
DJANGO_SECRET_KEY=replace-with-a-long-django-secret
DOCUMENT_ENCRYPTION_KEY=replace-with-a-stable-fernet-key
DOCUMENT_ALERT_EMAILS=
AZM_ANON_THROTTLE_RATE=60/hour
AZM_USER_THROTTLE_RATE=1000/hour
AZM_DB_POOL_MIN_SIZE=4
AZM_DB_POOL_MAX_SIZE=32
AZM_DB_POOL_TIMEOUT=30

# Error monitoring (https://sentry.io). Leave empty to disable.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Comma-separated emails that receive Django's built-in 500-error report
# (in addition to Sentry, as a fallback channel).
ADMIN_EMAILS=

DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=tidesight.cloud
CORS_ALLOWED_ORIGINS=https://tidesight.cloud
# Required behind the Caddy reverse proxy for session/CSRF-authenticated requests
# (e.g. the Django admin). Must include the scheme (https://).
CSRF_TRUSTED_ORIGINS=https://tidesight.cloud
PORTAL_BASE_URL=https://tidesight.cloud
