# Docker Compose PostgreSQL settings
POSTGRES_DB=azm
POSTGRES_USER=azm_app
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5432

# Django settings
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Optional in development. In production, set to the exact https:// browser origin(s).
CSRF_TRUSTED_ORIGINS=
PORTAL_BASE_URL=http://localhost:5173
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
DOCUMENT_ENCRYPTION_KEY=replace-with-a-fernet-key
DOCUMENT_ALERT_EMAILS=

# Error monitoring (https://sentry.io). Leave empty to disable locally.
SENTRY_DSN=
ADMIN_EMAILS=
